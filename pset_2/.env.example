# ============================================================
# PSet 2 - Subvenciones con Ruta
# Copia este archivo:   cp .env.example .env
# Rellena los valores en .env  (NUNCA subas .env a GitHub)
# ============================================================

# ---------- Snowflake (conexion compartida por Kestra, dbt y Spark) ----------
# Formato del account: <orgname>-<account_name> (ej. ABCDEFG-XY12345) o <locator>.<region>.<nube>
# (ej. AB12345.us-east-2.aws; el locator solo, sin región, da 404). Sin https:// ni .snowflakecomputing.com.
# Guarda este archivo con fines de línea LF y sin espacios alrededor del '=' (KEY=valor).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# Opcional (Spark): llave RSA si la cuenta exige MFA para password. Ej. /opt/secrets/snowflake_rsa_key.p8
# (la llave va en pset_2/secrets/, que está en .gitignore)
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
# Esquemas por capa (deben coincidir con docs/snowflake_setup.sql)
SNOWFLAKE_SCHEMA_BRONZE=
SNOWFLAKE_SCHEMA_SILVER=
SNOWFLAKE_SCHEMA_GOLD=
SNOWFLAKE_SCHEMA_OBT=

# ---------- Fuente de datos (S3) ----------
# OpenAlex es un bucket publico: no requiere credenciales AWS.
OPENALEX_S3_BASE=
AWS_REGION=
# Solo si usan una fuente privada (NSF copiada a su propio bucket); si no, dejar vacio
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- Kestra ----------
# Usuario de la UI (debe ser un email valido)
KESTRA_USER=
KESTRA_PASSWORD=
# Backend de Kestra (Postgres interno del docker-compose)
KESTRA_DB_USER=
KESTRA_DB_PASSWORD=

# ---------- dbt ----------
DBT_TARGET=
DBT_THREADS=

# ---------- Spark ----------
SPARK_WORKER_MEMORY=
SPARK_WORKER_CORES=
